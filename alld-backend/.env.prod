# ================================================================
# DBA ALLD - Production Environment Configuration
# Port Range: 5xxx (Production Server - Same server as Dev)
# Note: Prod uses 5xxx to avoid conflict with Dev (4xxx)
# ================================================================

# ===============================
# Application Ports (5xxx)
# ===============================
# Frontend (React)
FRONTEND_PORT=5080

# Backend (Spring Boot)
SERVER_PORT=5081
MANAGEMENT_PORT=5090

# File Server (HTTPS)
FILE_SERVER_PORT=5082

# ===============================
# Database Ports (5xxx)
# ===============================
DB_PORT=5306
DB_HOST=localhost
DB_NAME=dba
DB_USER=rwroot
DB_PASSWORD=${PROD_DB_PASSWORD}

# ===============================
# Monitoring Ports (5xxx/9xxx)
# ===============================
# Prometheus
PROMETHEUS_PORT=5900

# Grafana
GRAFANA_PORT=5300
GRAFANA_ADMIN_USER=${PROD_GRAFANA_ADMIN_USER}
GRAFANA_ADMIN_PASSWORD=${PROD_GRAFANA_ADMIN_PASSWORD}

# Alertmanager
ALERTMANAGER_PORT=5903

# cAdvisor
CADVISOR_PORT=5800

# Node Exporter
NODE_EXPORTER_PORT=5910

# ===============================
# Self-Healing Ports (5xxx)
# ===============================
SELF_HEALING_ALERT_PORT=5082
SELF_HEALING_LOG_PORT=5083
SELF_HEALING_ANOMALY_PORT=5084
SELF_HEALING_ORCHESTRATOR_PORT=5085

# ===============================
# Jenkins (5xxx)
# ===============================
JENKINS_PORT=5070
JENKINS_USER=${PROD_JENKINS_USER}
JENKINS_PASSWORD=${PROD_JENKINS_PASSWORD}

# ===============================
# JWT Configuration
# ===============================
JWT_SECRET=${PROD_JWT_SECRET}

# ===============================
# AWS S3 Configuration (Prod)
# ===============================
AWS_ACCESS_KEY_ID=${PROD_AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${PROD_AWS_SECRET_ACCESS_KEY}
AWS_S3_BUCKET=amazn-s3-dbaalld-prod
AWS_REGION=ap-south-1

# ===============================
# CORS Configuration
# ===============================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://localhost:5080,https://127.0.0.1:5080,https://dbaalld.org,https://www.dbaall d.org,https://dbaalld.thinkvalleysoftwares.in

# ===============================
# reCAPTCHA (Prod)
# ===============================
RECAPTCHA_SECRET_KEY=${PROD_RECAPTCHA_SECRET_KEY}
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_FAIL_FAST=true

# ===============================
# Upload Configuration
# ===============================
APP_UPLOAD_BASE_PATH=/opt/dbaalld-prod/uploads
MEDIA_BASE_URL=https://localhost:5082

# ===============================
# Logging
# ===============================
APP_LOG_DIR=/opt/dbaalld-prod/logs
LOG_LEVEL=WARN

# ===============================
# Cache Configuration
# ===============================
CACHE_TYPE=caffeine
CACHE_MAX_SIZE=20000
CACHE_EXPIRE_HOURS=2

# ===============================
# HikariCP Configuration
# ===============================
HIKARI_MAX_POOL_SIZE=50
HIKARI_MIN_IDLE=20
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=1800000
HIKARI_CONNECTION_TIMEOUT=20000

# ===============================
# Environment
# ===============================
SPRING_PROFILES_ACTIVE=prod
ENVIRONMENT=production

# ===============================
# Security (Production)
# ===============================
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=classpath:keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=${PROD_SSL_PASSWORD}
SERVER_SSL_KEY_ALIAS=dbaalld

# ===============================
# Rate Limiting (Production)
# ===============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ===============================
# Backup Configuration
# ===============================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90
