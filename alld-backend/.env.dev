# ================================================================
# DBA ALLD - Development Environment Configuration
# Port Range: 4xxx (Development Server)
# Note: Dev uses same ports as Local (different servers)
# ================================================================

# ===============================
# Application Ports (4xxx)
# ===============================
# Frontend (React)
FRONTEND_PORT=4080

# Backend (Spring Boot)
SERVER_PORT=4081
MANAGEMENT_PORT=4090

# File Server (HTTPS)
FILE_SERVER_PORT=4082

# ===============================
# Database Ports (4xxx)
# ===============================
DB_PORT=4306
DB_HOST=localhost
DB_NAME=dba
DB_USER=rwroot
DB_PASSWORD=${DEV_DB_PASSWORD:-dev_secure_password}

# ===============================
# Monitoring Ports (4xxx/9xxx)
# ===============================
# Prometheus
PROMETHEUS_PORT=4900

# Grafana
GRAFANA_PORT=4300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=${DEV_GRAFANA_PASSWORD:-admin123}

# Alertmanager
ALERTMANAGER_PORT=4903

# cAdvisor
CADVISOR_PORT=4800

# Node Exporter
NODE_EXPORTER_PORT=4910

# ===============================
# Self-Healing Ports (4xxx)
# ===============================
SELF_HEALING_ALERT_PORT=4082
SELF_HEALING_LOG_PORT=4083
SELF_HEALING_ANOMALY_PORT=4084
SELF_HEALING_ORCHESTRATOR_PORT=4085

# ===============================
# Jenkins (4xxx)
# ===============================
JENKINS_PORT=4070
JENKINS_USER=admin
JENKINS_PASSWORD=${DEV_JENKINS_PASSWORD:-admin123}

# ===============================
# JWT Configuration
# ===============================
JWT_SECRET=${DEV_JWT_SECRET:-dev-jwt-secret-key-min-32-characters-required}

# ===============================
# AWS S3 Configuration (Dev)
# ===============================
# AWS S3 Configuration (Dev)
AWS_ACCESS_KEY_ID=${DEV_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${DEV_SECRET_KEY}
AWS_S3_BUCKET=amazn-s3-dbaalld-dev
AWS_REGION=ap-south-1
S3_ENABLED=true

# ===============================
# CORS Configuration
# ===============================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:4080,http://127.0.0.1:4080,https://dev.dbaalld.local

# ===============================
# reCAPTCHA (Dev)
# ===============================
RECAPTCHA_SECRET_KEY=${DEV_RECAPTCHA_SECRET_KEY}
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_FAIL_FAST=true

# ===============================
# Upload Configuration
# ===============================
APP_UPLOAD_BASE_PATH=/home/dbadev01/app-deployment-dev/backend
MEDIA_BASE_URL=https://localhost:4082

# ===============================
# Logging
# ===============================
APP_LOG_DIR=/opt/dbaalld/logs
LOG_LEVEL=INFO

# ===============================
# Cache Configuration
# ===============================
CACHE_TYPE=caffeine
CACHE_MAX_SIZE=10000
CACHE_EXPIRE_HOURS=1

# ===============================
# HikariCP Configuration
# ===============================
HIKARI_MAX_POOL_SIZE=25
HIKARI_MIN_IDLE=10
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=1200000
HIKARI_CONNECTION_TIMEOUT=20000

# ===============================
# Environment
# ===============================
SPRING_PROFILES_ACTIVE=dev
ENVIRONMENT=development
