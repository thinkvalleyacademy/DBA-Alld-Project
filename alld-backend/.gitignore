# ===========================
# Environment (keep .example, ignore actual files)
# ===========================
.env
.env.local
.env.*.local

# Keep these (templates)
!.env.example
!.env.dev
!.env.prod

# ===========================
# Test artifacts
# ===========================
test-results/
playwright-report/

