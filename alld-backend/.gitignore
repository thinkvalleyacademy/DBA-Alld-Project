# Deployment (ignore sensitive data)
# ===========================
deployment/database/backups/
deployment/monitoring/*/grafana-data/
deployment/monitoring/*/prometheus-data/

# ===========================
# Docker (ignore runtime data)
# ===========================
docker-compose.override.yml

