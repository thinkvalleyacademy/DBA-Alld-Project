pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    // Repository Configuration
    BACKEND_REPO = 'git@github.com:thinkvalleyacademy/DBA-SOFTWARE.git'
    BACKEND_BRANCH = 'dev'
    GIT_CREDENTIALS_ID = 'github-ssh'

    // Deployment Paths
    DEPLOY_ROOT = '/home/dbadev01/app-deployment-dev'
    COMPOSE_FILE = '/home/dbadev01/app-deployment-dev/docker-compose.backend.dev.yml'
    ENV_FILE = '/home/dbadev01/app-deployment-dev/.env'
    MONITORING_DIR = '/home/dbadev01/app-deployment-dev/monitoring'
    SELF_HEALING_DIR = '/home/dbadev01/app-deployment-dev/self-healing'

    // Docker Configuration
    IMAGE_NAME = 'dba/backend'
    CONTAINER_NAME = 'dba-dev-backend'
    DB_CONTAINER_NAME = 'dba-dev-db'

    // Network
    TRAEFIK_NETWORK = 'traefik-public'
    INTERNAL_NETWORK = 'dba-dev-internal'
  }

  parameters {
    // Build Parameters
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Optional tag override; default BUILD_NUMBER')
    booleanParam(name: 'FORCE_IMAGE_BUILD', defaultValue: false, description: 'Force Docker image rebuild')
    booleanParam(name: 'RUN_UNIT_TESTS', defaultValue: true, description: 'Run unit tests before deploy')
    
    // Deployment Parameters
    string(name: 'BACKEND_HOST', defaultValue: '100.101.103.63', description: 'Host/domain for Traefik route')
    string(name: 'TRAEFIK_ENTRYPOINT', defaultValue: 'web', description: 'Traefik entrypoint name')
    choice(name: 'TRAEFIK_TLS', choices: ['false', 'true'], description: 'Enable TLS at Traefik')
    string(name: 'BACKEND_PORT', defaultValue: '5081', description: 'Host port for backend')
    
    // Database Parameters
    string(name: 'MYSQL_DATABASE', defaultValue: 'dba', description: 'MySQL database name')
    string(name: 'MYSQL_USER', defaultValue: 'rwroot', description: 'MySQL application user')
    booleanParam(name: 'RECREATE_DB', defaultValue: false, description: 'Recreate DB container')
    booleanParam(name: 'BACKUP_BEFORE_DEPLOY', defaultValue: true, description: 'Create DB backup before deploy')

    // Credentials (Jenkins Secret Text)
    string(name: 'MYSQL_ROOT_PASSWORD_CRED_ID', defaultValue: 'dba-dev-mysql-root-password', description: 'Jenkins Secret Text credentialsId')
    string(name: 'MYSQL_PASSWORD_CRED_ID', defaultValue: 'dba-dev-mysql-app-password', description: 'Jenkins Secret Text credentialsId')
    string(name: 'JWT_SECRET_CRED_ID', defaultValue: 'dba-dev-jwt-secret', description: 'Jenkins Secret Text credentialsId')
    string(name: 'AWS_ACCESS_KEY_ID_CRED_ID', defaultValue: 'dba-dev-aws-access-key-id', description: 'Jenkins Secret Text credentialsId')
    string(name: 'AWS_SECRET_ACCESS_KEY_CRED_ID', defaultValue: 'dba-dev-aws-secret-access-key', description: 'Jenkins Secret Text credentialsId')
    
    // Rollback Parameters
    booleanParam(name: 'ROLLBACK', defaultValue: false, description: 'Rollback to previous deployment')
    string(name: 'ROLLBACK_TAG', defaultValue: '', description: 'Tag to rollback to (leave empty for previous)')
  }

  stages {
    stage('Initialize') {
      steps {
        script {
          env.BUILD_TAG = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : env.BUILD_NUMBER
          env.IMAGE_REF = "${IMAGE_NAME}:${BUILD_TAG}"
          env.IMAGE_DEV = "${IMAGE_NAME}:dev"

          echo "========================================="
          echo "DBA ALLD Backend Deployment"
          echo "========================================="
          echo "Build Tag: ${BUILD_TAG}"
          echo "Image: ${IMAGE_REF}"
          echo "Deploy Root: ${DEPLOY_ROOT}"
          echo "========================================="
        }
      }
    }

    stage('Checkout') {
      steps {
        echo 'Checking out code...'
        checkout scm
      }
    }

    stage('Detect Changes') {
      steps {
        script {
          def prev = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT?.trim()
          def curr = env.GIT_COMMIT?.trim()

          if (!prev || !curr) {
            env.BUILD_IMAGE_NEEDED = 'true'
            echo 'No previous commit metadata; building image.'
          } else {
            def changed = sh(
              script: "git diff --name-only ${prev} ${curr}",
              returnStdout: true
            ).trim()
            echo "Changed files:\n${changed}"

            def buildNeeded = changed.split('\n').any { path ->
              path.matches(/^(Dockerfile|pom\.xml|mvnw|\.mvn\/|src\/).*/)
            }

            env.BUILD_IMAGE_NEEDED = buildNeeded ? 'true' : 'false'
          }

          if (params.FORCE_IMAGE_BUILD) {
            env.BUILD_IMAGE_NEEDED = 'true'
          }
          
          echo "Build needed: ${env.BUILD_IMAGE_NEEDED}"
        }
      }
    }

    stage('Run Unit Tests') {
      when {
        expression { return params.RUN_UNIT_TESTS }
      }
      steps {
        echo 'Running unit tests...'
        sh '''
          set -eux
          ./mvnw -q test -DskipTests=false
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
        }
      }
    }

    stage('Rollback') {
      when {
        expression { return params.ROLLBACK }
      }
      stages {
        stage('Get Previous Tag') {
          steps {
            script {
              if (params.ROLLBACK_TAG?.trim()) {
                env.ROLLBACK_IMAGE = "${IMAGE_NAME}:${params.ROLLBACK_TAG.trim()}"
              } else {
                // Get previous successful build
                def prevBuild = currentBuild.previousSuccessfulBuild
                if (prevBuild) {
                  env.ROLLBACK_IMAGE = "${IMAGE_NAME}:${prevBuild.id}"
                } else {
                  error 'No previous successful build found for rollback'
                }
              }
              echo "Rolling back to: ${env.ROLLBACK_IMAGE}"
            }
          }
        }
        
        stage('Execute Rollback') {
          steps {
            sh '''
              set -eux
              cd "$DEPLOY_ROOT"
              
              # Backup current state
              docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" ps > rollback_backup_$(date +%Y%m%d_%H%M%S).txt || true
              
              # Stop current backend
              docker stop "$CONTAINER_NAME" || true
              docker rm "$CONTAINER_NAME" || true
              
              # Pull rollback image if not local
              docker pull "$ROLLBACK_IMAGE" || true
              
              # Update env file
              if grep -q '^BACKEND_IMAGE=' "$ENV_FILE"; then
                sed -i.bak "s|^BACKEND_IMAGE=.*|BACKEND_IMAGE=${ROLLBACK_IMAGE}|" "$ENV_FILE"
              else
                echo "BACKEND_IMAGE=${ROLLBACK_IMAGE}" >> "$ENV_FILE"
              fi
              rm -f "$ENV_FILE.bak"
              
              # Start rollback version
              docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" up -d backend
              docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" ps
            '''
          }
        }
      }
    }

    stage('Prepare Deployment') {
      steps {
        echo 'Preparing deployment folder...'
        sh '''
          set -eux
          mkdir -p "$DEPLOY_ROOT" "$DEPLOY_ROOT/data/mysql" "$DEPLOY_ROOT/initdb" "$DEPLOY_ROOT/backend-storage" "$DEPLOY_ROOT/backend-logs" "$DEPLOY_ROOT/scripts"

          # Create networks if not exist
          docker network inspect "$TRAEFIK_NETWORK" >/dev/null 2>&1 || docker network create "$TRAEFIK_NETWORK"
          docker network inspect "$INTERNAL_NETWORK" >/dev/null 2>&1 || docker network create "$INTERNAL_NETWORK"
        '''
      }
    }

    stage('Sync Deployment Files') {
      steps {
        echo 'Syncing deployment files...'
        sh '''
          set -eux
          
          # Copy docker-compose file to deploy root
          cp "$WORKSPACE/deployment/docker-compose.backend.dev.yml" "$COMPOSE_FILE"
          
          # Copy deployment scripts to deploy root
          mkdir -p "$DEPLOY_ROOT/scripts"
          cp -r "$WORKSPACE/deployment/scripts/"* "$DEPLOY_ROOT/scripts/" 2>/dev/null || true
          chmod +x "$DEPLOY_ROOT/scripts/"*.sh 2>/dev/null || true
          
          echo "✅ Deployment files synced"
        '''
      }
    }

    stage('Database Backup') {
      when {
        expression { return params.BACKUP_BEFORE_DEPLOY && !params.ROLLBACK }
      }
      steps {
        echo 'Creating database backup...'
        script {
          try {
            sh '''
              set -eux
              BACKUP_DIR="$DEPLOY_ROOT/database-backups"
              mkdir -p "$BACKUP_DIR"
              
              if docker ps --format '{{.Names}}' | grep -q "^${DB_CONTAINER_NAME}$"; then
                TIMESTAMP=$(date +%Y%m%d_%H%M%S)
                BACKUP_FILE="$BACKUP_DIR/db_backup_${TIMESTAMP}.sql.gz"
                
                docker exec "$DB_CONTAINER_NAME" mysqldump -uroot -p"$MYSQL_ROOT_PASSWORD" \
                  --all-databases --single-transaction --quick --lock-tables=false 2>/dev/null | gzip > "$BACKUP_FILE"
                
                echo "✅ Database backup created: $BACKUP_FILE"
                
                # Cleanup old backups (keep 7 days)
                find "$BACKUP_DIR" -name "*.sql.gz" -mtime +7 -delete
                echo "✅ Cleaned up old backups"
              else
                echo "⚠️  Database container not running, skipping backup"
              fi
            '''
          } catch (Exception e) {
            echo "⚠️  Database backup failed: ${e.message}"
            echo "Continuing deployment without backup..."
          }
        }
      }
    }

    stage('Write Environment File') {
      steps {
        withCredentials([
          string(credentialsId: params.MYSQL_ROOT_PASSWORD_CRED_ID, variable: 'MYSQL_ROOT_PASSWORD_VAL'),
          string(credentialsId: params.MYSQL_PASSWORD_CRED_ID, variable: 'MYSQL_PASSWORD_VAL'),
          string(credentialsId: params.JWT_SECRET_CRED_ID, variable: 'JWT_SECRET_VAL'),
          string(credentialsId: params.AWS_ACCESS_KEY_ID_CRED_ID, variable: 'AWS_ACCESS_KEY_ID_VAL'),
          string(credentialsId: params.AWS_SECRET_ACCESS_KEY_CRED_ID, variable: 'AWS_SECRET_ACCESS_KEY_VAL')
        ]) {
          sh '''
            set -e
            : "${MYSQL_ROOT_PASSWORD_VAL:?missing MYSQL_ROOT_PASSWORD}"
            : "${MYSQL_PASSWORD_VAL:?missing MYSQL_PASSWORD}"
            : "${JWT_SECRET_VAL:?missing JWT_SECRET}"
            : "${AWS_ACCESS_KEY_ID_VAL:?missing AWS_ACCESS_KEY_ID}"
            : "${AWS_SECRET_ACCESS_KEY_VAL:?missing AWS_SECRET_ACCESS_KEY}"
            
            umask 077
            cat > "$ENV_FILE" <<EOF
BACKEND_HOST=${BACKEND_HOST}
TRAEFIK_ENTRYPOINT=${TRAEFIK_ENTRYPOINT}
TRAEFIK_TLS=${TRAEFIK_TLS}
BACKEND_PORT=${BACKEND_PORT}

TZ=Asia/Kolkata
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD_VAL}
MYSQL_DATABASE=${MYSQL_DATABASE}
MYSQL_USER=${MYSQL_USER}
MYSQL_PASSWORD=${MYSQL_PASSWORD_VAL}

JWT_SECRET=${JWT_SECRET_VAL}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID_VAL}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY_VAL}
APP_LOG_DIR=/var/log/dba-alld
BACKEND_IMAGE=${IMAGE_REF}
BACKEND_IMAGE_DEV=${IMAGE_DEV}
EOF
            chmod 600 "$ENV_FILE"
            echo "✅ Environment file created: $ENV_FILE"
          '''
        }
      }
    }

    stage('Build Docker Image') {
      when {
        expression { return env.BUILD_IMAGE_NEEDED == 'true' && !params.ROLLBACK }
      }
      steps {
        echo "Building Docker image: ${IMAGE_REF}"
        sh '''
          set -eux
          cd "$WORKSPACE"
          
          # Ensure we use the correct Docker socket for rootless Docker
          export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/$(id -u)/docker.sock}"

          # Build image (Jenkins runs on server, so image will be available locally)
          # Tag with both build number and 'dev' for docker-compose
          docker build \
            -t "${IMAGE_REF}" \
            -t "${IMAGE_DEV}" \
            -f Dockerfile \
            .

          echo "✅ Docker image built: ${IMAGE_REF}"
        '''
      }
    }

    stage('Transfer Image to Server') {
      when {
        expression { return env.BUILD_IMAGE_NEEDED == 'true' && !params.ROLLBACK }
      }
      steps {
        echo "✅ Image already available on server (Jenkins runs locally) - skipping transfer"
      }
    }

    stage('Ensure Image Available') {
      steps {
        echo 'Checking if Docker image exists...'
        sh '''
          set -eux

          # Get the image tag from Jenkins environment
          IMAGE_TAG="${BUILD_TAG}"
          FULL_IMAGE_NAME="${IMAGE_NAME}:${IMAGE_TAG}"

          echo "Checking for image: $FULL_IMAGE_NAME"

          # Check if image exists locally
          if ! docker image inspect "$FULL_IMAGE_NAME" >/dev/null 2>&1; then
            echo "⚠️  Image $FULL_IMAGE_NAME not found!"
            echo ""
            echo "This can happen when:"
            echo "  - Tests were skipped (RUN_UNIT_TESTS=false)"
            echo "  - Build stage was skipped (no code changes detected)"
            echo "  - Image was cleaned up by docker prune"
            echo "  - Manual deployment without build"
            echo ""
            echo "🔨 Building image automatically..."
            echo ""

            cd "$WORKSPACE"
            export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/$(id -u)/docker.sock}"

            # Build with both specific tag and 'dev' tag
            docker build \
              -t "${FULL_IMAGE_NAME}" \
              -t "${IMAGE_NAME}:dev" \
              -f Dockerfile \
              .

            echo ""
            echo "✅ Image built successfully: $FULL_IMAGE_NAME"
            echo "✅ Also tagged as: ${IMAGE_NAME}:dev"
          else
            echo "✅ Image already exists: $FULL_IMAGE_NAME"
          fi
        '''
      }
    }

    stage('Deploy Backend') {
      steps {
        echo 'Deploying backend service...'
        sh '''
          set -eux
          cd "$DEPLOY_ROOT"

          # DOCKER_HOST check for rootless docker
          export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/$(id -u)/docker.sock}"

          # Deploy services (--pull never is safe now because Ensure Image Available already built it)
          if [ "${RECREATE_DB}" = "true" ]; then
            docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" up -d --force-recreate --remove-orphans db backend
          else
            docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" up -d --force-recreate --remove-orphans backend
          fi

          # Show status
          docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" ps

          echo "✅ Backend deployed successfully"
        '''
      }
    }

    stage('Health Check') {
      steps {
        echo 'Waiting for backend to be healthy...'
        script {
          def maxRetries = 20
          def retryInterval = 15 // seconds
          def healthy = false
          
          for (int i = 0; i < maxRetries; i++) {
            sleep retryInterval
            def status = sh(
              script: "docker inspect --format='{{.State.Health.Status}}' ${CONTAINER_NAME} 2>/dev/null || echo 'not_found'",
              returnStdout: true
            ).trim()
            
            echo "Health check attempt ${i+1}/${maxRetries}: ${status}"
            
            if (status == 'healthy') {
              healthy = true
              break
            }
          }
          
          if (!healthy) {
            error "Backend failed to become healthy after ${maxRetries * retryInterval} seconds"
          }
          
          echo "✅ Backend is healthy"
        }
      }
    }

    stage('Post-Deployment Verification') {
      steps {
        echo 'Running post-deployment verification...'
        sh '''
          set -eux
          
          # Check container status
          docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" | grep -E "${CONTAINER_NAME}|${DB_CONTAINER_NAME}"
          
          # Test backend endpoint
          sleep 5
          curl -s -o /dev/null -w "HTTP Status: %{http_code}\n" http://localhost:${BACKEND_PORT}/actuator/health || echo "⚠️  Health endpoint not responding yet"
          
          # Check logs for errors
          docker logs --tail 50 "$CONTAINER_NAME" | grep -i error || echo "✅ No errors in recent logs"
          
          echo "✅ Post-deployment verification complete"
        '''
      }
    }
  }

  post {
    always {
      echo 'Cleaning up workspace...'
      cleanWs()
    }
    success {
      echo '✅ Deployment successful!'
      script {
        def grafanaUrl = "http://${params.BACKEND_HOST}:4001"
        def backendUrl = "http://${params.BACKEND_HOST}:${params.BACKEND_PORT}"
        
        echo """
        ╔══════════════════════════════════════════════════════════╗
        ║     ✅ DEPLOYMENT SUCCESSFUL                             ║
        ╚══════════════════════════════════════════════════════════╝
        
        📦 Backend Image: ${IMAGE_REF}
        🌐 Backend URL: ${backendUrl}/dba-alld
        📊 Health Check: ${backendUrl}/dba-alld/actuator/health
        📈 Grafana: ${grafanaUrl}
        
        📋 Useful Commands:
          # View logs
          docker logs -f ${CONTAINER_NAME}
          
          # Check status
          docker compose -f ${COMPOSE_FILE} ps
          
          # Restart backend
          docker restart ${CONTAINER_NAME}
        """
      }
    }
    failure {
      echo '❌ Deployment failed!'
      script {
        def logs = sh(
          script: "docker logs --tail 100 ${CONTAINER_NAME} 2>&1 || echo 'Container not started'",
          returnStdout: true
        ).trim()
        
        echo """
        ╔══════════════════════════════════════════════════════════╗
        ║     ❌ DEPLOYMENT FAILED                                 ║
        ╚══════════════════════════════════════════════════════════╝
        
        🔍 Last 100 log lines:
        ${logs}
        
        🔧 Troubleshooting:
          # Check container status
          docker ps -a | grep ${CONTAINER_NAME}
          
          # View full logs
          docker logs ${CONTAINER_NAME}
          
          # Check environment file
          cat ${ENV_FILE}
        """
      }
    }
    unstable {
      echo '⚠️  Deployment completed with warnings'
    }
  }
}
