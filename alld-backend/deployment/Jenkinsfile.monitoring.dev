pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timeout(time: 15, unit: 'MINUTES')
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  environment {
    // Deployment Paths
    DEPLOY_ROOT = '/home/dbadev01/app-deployment-dev'
    COMPOSE_FILE = '/home/dbadev01/app-deployment-dev/docker-compose.monitoring.dev.yml'
    MONITORING_DIR = '/home/dbadev01/app-deployment-dev/monitoring/dev'

    // Docker Configuration
    CONTAINER_PROMETHEUS = 'dba-dev-prometheus'
    CONTAINER_GRAFANA = 'dba-dev-grafana'

    // Network
    NETWORK_NAME = 'dba-dev-internal'

    // Ports
    GRAFANA_PORT = '4001'
    PROMETHEUS_PORT = '4090'
    BACKEND_METRICS_PORT = '8090'
  }

  parameters {
    booleanParam(name: 'RECREATE_MONITORING', defaultValue: false, description: 'Recreate all monitoring containers')
    booleanParam(name: 'RESET_GRAFANA_PASSWORD', defaultValue: false, description: 'Reset Grafana password to default (admin123)')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Deploy DEV Monitoring') {
      steps {
        echo 'Deploying DEV monitoring stack...'
        sh '''
          set -eux
          cd "$DEPLOY_ROOT"

          # Copy monitoring configs from workspace
          mkdir -p "$MONITORING_DIR"
          rsync -a --delete "$WORKSPACE/deployment/monitoring/dev/" "$MONITORING_DIR/"

          # Copy docker-compose file
          cp "$WORKSPACE/deployment/docker-compose.monitoring.dev.yml" "$COMPOSE_FILE"

          # Create network if not exists
          docker network inspect "$NETWORK_NAME" >/dev/null 2>&1 || \
            docker network create "$NETWORK_NAME"

          # Handle reset password
          if [ "${RESET_GRAFANA_PASSWORD}" = "true" ]; then
            echo "Resetting Grafana data..."
            rm -rf "$MONITORING_DIR/grafana-data"
            mkdir -p "$MONITORING_DIR/grafana-data"
          fi

          # Deploy monitoring stack
          if [ "${RECREATE_MONITORING}" = "true" ]; then
            echo "Recreating monitoring containers..."
            docker compose -f "$COMPOSE_FILE" down
            docker compose -f "$COMPOSE_FILE" up -d --force-recreate
          else
            echo "Starting monitoring stack..."
            docker compose -f "$COMPOSE_FILE" up -d
          fi

          # Connect Prometheus to Docker bridge network (to reach backend)
          echo "Connecting Prometheus to Docker bridge network..."
          docker network connect bridge "$CONTAINER_PROMETHEUS" 2>/dev/null || true

          # Connect Grafana to Docker bridge network (to reach Prometheus)
          echo "Connecting Grafana to Docker bridge network..."
          docker network connect bridge "$CONTAINER_GRAFANA" 2>/dev/null || true

          # Wait for services
          echo "Waiting for services to start..."
          sleep 15

          # Show status
          docker compose -f "$COMPOSE_FILE" ps

          # Health checks
          echo ""
          echo "Running health checks..."

          # Check Prometheus
          if curl -s http://localhost:${PROMETHEUS_PORT}/-/healthy >/dev/null 2>&1; then
            echo "✅ Prometheus DEV is healthy"
          else
            echo "⚠️  Prometheus DEV health check failed"
          fi

          # Check Grafana
          if curl -s http://localhost:${GRAFANA_PORT}/api/health | grep -q '"database":"ok"'; then
            echo "✅ Grafana DEV is healthy"
          else
            echo "⚠️  Grafana DEV health check failed"
          fi

          echo ""
          echo "========================================="
          echo "✅ DEV Monitoring Stack Deployed"
          echo "========================================="
          echo ""
          echo "📊 Prometheus: http://100.101.103.63:${PROMETHEUS_PORT}"
          echo "📈 Grafana:    http://100.101.103.63:${GRAFANA_PORT}"
          echo ""
          echo "Grafana Login:"
          echo "  Username: admin"
          echo "  Password: admin123"
          echo ""
          echo "⚠️  IMPORTANT: Change the default password after first login!"
          echo "========================================="
        '''
      }
    }

    stage('Verify Backend Metrics') {
      steps {
        echo 'Verifying DEV backend metrics endpoint...'
        sh '''
          set -eux

          echo "Checking DEV backend metrics..."
          if curl -s http://100.101.103.63:${BACKEND_METRICS_PORT}/actuator/prometheus >/dev/null 2>&1; then
            echo "✅ DEV backend metrics endpoint is accessible"
          else
            echo "⚠️  DEV backend metrics endpoint not accessible"
            echo "   Ensure DEV backend is running with management.port=8090"
          fi
        '''
      }
    }
  }

  post {
    always {
      echo 'Cleaning up workspace...'
      cleanWs()
    }
    success {
      echo '✅ DEV monitoring deployment successful!'
    }
    failure {
      echo '❌ DEV monitoring deployment failed!'
      script {
        def logs = sh(
          script: "docker compose -f $COMPOSE_FILE logs --tail=50 2>&1",
          returnStdout: true
        ).trim()

        echo """
        🔍 Last 50 log lines:
        ${logs}

        🔧 Troubleshooting:
          # Check container status
          docker compose -f $COMPOSE_FILE ps

          # View logs
          docker compose -f $COMPOSE_FILE logs -f prometheus
          docker compose -f $COMPOSE_FILE logs -f grafana

          # Restart monitoring
          docker compose -f $COMPOSE_FILE restart
        """
      }
    }
  }
}
