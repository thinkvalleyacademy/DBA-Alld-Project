# ================================================================
# Docker Image - Database Migration Tool
# Used by Jenkins pipelines for database migrations
# ================================================================
FROM mysql:8.0

# Labels
LABEL maintainer="DBA Team"
LABEL description="Database migration tool for DBA ALLD"
LABEL version="1.0"

# Install required tools
RUN apt-get update && apt-get install -y \
    bash \
    gzip \
    sha256sum \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /migrations

# Copy migration scripts
COPY database/migrations/*.sql /migrations/
COPY deployment/scripts/*.sh /scripts/

# Make scripts executable
RUN chmod +x /scripts/*.sh

# Set environment variables
ENV DB_HOST=localhost
ENV DB_PORT=3306
ENV DB_USER=root
ENV DB_PASSWORD=
ENV DB_NAME=dba
ENV MIGRATION_DIR=/migrations
ENV BACKUP_DIR=/backups

# Create backup directory
RUN mkdir -p /backups

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD mysql -h "${DB_HOST}" -P "${DB_PORT}" -u "${DB_USER}" -p"${DB_PASSWORD}" -e "SELECT 1;" ${DB_NAME} || exit 1

# Entry point for migration
ENTRYPOINT ["/scripts/migrate-database.sh"]
