pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  environment {
    // Local Code Path Configuration
    // Option 1: Use Jenkins workspace directly (default)
    CODE_ROOT = "${WORKSPACE}"
    
    // Option 2: Use a specific linked directory (uncomment and modify as needed)
    // CODE_ROOT = "/home/mukeshkumar/workspace/alld-backend"

    // Local Deployment Paths
    DEPLOY_ROOT = "${WORKSPACE}/dist"

    // Docker Configuration
    REGISTRY = 'localhost'
    IMAGE_NAME = 'alld/backend'
    CONTAINER_NAME = 'alld-backend-local'
    DB_CONTAINER_NAME = 'alld-db-local'

    // Local Network
    DOCKER_NETWORK = 'alld-local'

    // Application Config
    JAVA_VERSION = '21'
    MAVEN_OPTS = '-Xmx1024m -Xms512m'
  }

  parameters {
    // Build Parameters
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker image tag (default: BUILD_NUMBER)')
    booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run unit tests')
    booleanParam(name: 'FORCE_BUILD', defaultValue: false, description: 'Force rebuild even with no changes')
    booleanParam(name: 'SKIP_TESTS_ON_ERROR', defaultValue: false, description: 'Skip tests if compilation fails')

    // Deployment Parameters
    choice(name: 'DEPLOYMENT_ACTION', choices: ['deploy', 'rebuild', 'restart', 'logs', 'rollback'], description: 'Deployment action')
    booleanParam(name: 'CREATE_DB_BACKUP', defaultValue: true, description: 'Backup database before deploying')
    
    // Local Configuration
    string(name: 'BACKEND_PORT', defaultValue: '8080', description: 'Local backend port')
    string(name: 'DB_PORT', defaultValue: '3306', description: 'Local database port')
    string(name: 'MYSQL_DATABASE', defaultValue: 'dba_dev', description: 'Database name')
  }

  stages {
    stage('Initialization') {
      steps {
        script {
          env.BUILD_TAG = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : env.BUILD_NUMBER
          env.IMAGE_REF = "${REGISTRY}/${IMAGE_NAME}:${BUILD_TAG}"
          env.IMAGE_LOCAL = "${REGISTRY}/${IMAGE_NAME}:latest"

          echo "╔════════════════════════════════════════════════════════════╗"
          echo "║    🚀 DBA ALLD Backend Local Build & Deploy (No Git)      ║"
          echo "╚════════════════════════════════════════════════════════════╝"
          echo ""
          echo "Build Configuration:"
          echo "  Build Number: ${BUILD_NUMBER}"
          echo "  Build Tag: ${BUILD_TAG}"
          echo "  Image Tag: ${IMAGE_REF}"
          echo "  Action: ${params.DEPLOYMENT_ACTION}"
          echo "  Run Tests: ${params.RUN_TESTS}"
          echo "  Code Root: ${CODE_ROOT}"
          echo "  Deployment Root: ${DEPLOY_ROOT}"
          echo ""
        }
      }
    }

    stage('Verify Local Code') {
      steps {
        echo '📁 Verifying local code exists...'
        sh '''
          set -eux
          
          # Check if key files exist
          if [ ! -f "${CODE_ROOT}/pom.xml" ]; then
            echo "❌ ERROR: pom.xml not found in ${CODE_ROOT}"
            echo ""
            echo "Setup Instructions:"
            echo "1. Copy your backend code to: ${CODE_ROOT}"
            echo "   OR"
            echo "2. Create symbolic link:"
            echo "     mkdir -p $(dirname ${CODE_ROOT})"
            echo "     ln -s /path/to/your/alld-backend ${CODE_ROOT}"
            echo "   OR"
            echo "3. Update CODE_ROOT environment variable in Jenkinsfile"
            exit 1
          fi
          
          if [ ! -f "${CODE_ROOT}/Dockerfile" ]; then
            echo "❌ ERROR: Dockerfile not found in ${CODE_ROOT}"
            exit 1
          fi
          
          if [ ! -f "${CODE_ROOT}/mvnw" ]; then
            echo "❌ ERROR: mvnw not found in ${CODE_ROOT}"
            exit 1
          fi
          
          # Show directory structure
          echo "✅ Local code verified"
          echo ""
          echo "📂 Code structure:"
          ls -la "${CODE_ROOT}" | head -15
          echo ""
          echo "✅ pom.xml: Found"
          echo "✅ Dockerfile: Found"
          echo "✅ mvnw: Found"
        '''
      }
    }

    stage('Validate Environment') {
      steps {
        echo '✅ Validating Docker and Docker Compose...'
        sh '''
          set -eux
          
          # Check Docker
          docker --version
          docker ps -q > /dev/null 2>&1 || { echo "❌ Docker daemon not running"; exit 1; }
          
          # Check Docker Compose
          docker compose version
          
          # Create local network if not exists
          docker network inspect "${DOCKER_NETWORK}" >/dev/null 2>&1 || \
            docker network create "${DOCKER_NETWORK}"
          
          echo "✅ Environment validation passed"
        '''
      }
    }

    stage('Prepare Maven') {
      steps {
        echo '📦 Preparing Maven build...'
        sh '''
          set -eux
          
          cd "${CODE_ROOT}"
          
          # Ensure Maven wrapper is executable
          chmod +x ./mvnw
          
          # Display Maven version
          ./mvnw --version
          
          echo "✅ Maven prepared"
        '''
      }
    }

    stage('Build') {
      steps {
        echo '🔨 Building application...'
        sh '''
          set -eux
          
          cd "${CODE_ROOT}"
          
          export MAVEN_OPTS="${MAVEN_OPTS}"
          
          # Clean and compile
          ./mvnw clean compile
          
          echo "✅ Build successful"
        '''
      }
    }

    stage('Unit Tests') {
      when {
        expression { return params.RUN_TESTS }
      }
      steps {
        echo '🧪 Running unit tests...'
        sh '''
          set -eux
          
          cd "${CODE_ROOT}"
          
          export MAVEN_OPTS="${MAVEN_OPTS}"
          
          # Run tests with Maven
          ./mvnw test -Dsurefire.rerunFailingTestsCount=0 || {
            if [ "${SKIP_TESTS_ON_ERROR}" = "true" ]; then
              echo "⚠️  Tests failed, but continuing (SKIP_TESTS_ON_ERROR=true)"
              exit 0
            else
              exit 1
            fi
          }
          
          echo "✅ Tests passed"
        '''
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '${CODE_ROOT}/**/target/surefire-reports/*.xml'
        }
      }
    }

    stage('Package Application') {
      steps {
        echo '📦 Packaging application...'
        sh '''
          set -eux
          
          cd "${CODE_ROOT}"
          
          export MAVEN_OPTS="${MAVEN_OPTS}"
          
          # Package without tests (already ran)
          ./mvnw package -DskipTests=true
          
          echo "✅ Packaging successful"
        '''
      }
    }

    stage('Prepare Deployment') {
      steps {
        echo '📁 Preparing deployment directories...'
        sh '''
          set -eux
          
          # Create deployment structure
          mkdir -p "${DEPLOY_ROOT}"
          mkdir -p "${DEPLOY_ROOT}/data/mysql"
          mkdir -p "${DEPLOY_ROOT}/backups"
          mkdir -p "${DEPLOY_ROOT}/logs"
          
          # Copy docker-compose file
          cp "${CODE_ROOT}/deployment/docker-compose.backend.dev.yml" "${DEPLOY_ROOT}/"
          
          echo "✅ Deployment directories prepared"
        '''
      }
    }

    stage('Database Backup') {
      when {
        expression { 
          return params.CREATE_DB_BACKUP && params.DEPLOYMENT_ACTION in ['deploy', 'rebuild']
        }
      }
      steps {
        echo '💾 Creating database backup...'
        script {
          try {
            sh '''
              set -eux
              
              BACKUP_DIR="${DEPLOY_ROOT}/backups"
              mkdir -p "${BACKUP_DIR}"
              
              # Check if DB container is running
              if docker ps --format '{{.Names}}' | grep -q "^${DB_CONTAINER_NAME}$"; then
                TIMESTAMP=$(date +%Y%m%d_%H%M%S)
                BACKUP_FILE="${BACKUP_DIR}/db_backup_${TIMESTAMP}.sql.gz"
                
                # Backup database
                docker exec "${DB_CONTAINER_NAME}" mysqldump \
                  -u root -p"${MYSQL_ROOT_PASSWORD:=root}" \
                  --all-databases --single-transaction --quick 2>/dev/null | \
                  gzip > "${BACKUP_FILE}"
                
                echo "✅ Database backup created: ${BACKUP_FILE}"
                
                # Keep only last 5 backups
                ls -1t "${BACKUP_DIR}"/db_backup_*.sql.gz 2>/dev/null | tail -n +6 | xargs -r rm --
                echo "✅ Cleanup: kept last 5 backups"
              else
                echo "⚠️  DB container not running, skipping backup"
              fi
            '''
          } catch (Exception e) {
            echo "⚠️  Backup failed: ${e.message}"
            echo "Continuing with deployment..."
          }
        }
      }
    }

    stage('Build Docker Image') {
      when {
        expression { 
          return params.DEPLOYMENT_ACTION in ['deploy', 'rebuild']
        }
      }
      steps {
        echo "🐳 Building Docker image: ${IMAGE_REF}"
        sh '''
          set -eux
          
          cd "${CODE_ROOT}"
          
          # Build Docker image
          docker build \
            --build-arg JAVA_VERSION="${JAVA_VERSION}" \
            --tag "${IMAGE_REF}" \
            --tag "${IMAGE_LOCAL}" \
            --file Dockerfile \
            .
          
          # Show image info
          docker images | grep "${IMAGE_NAME}"
          
          echo "✅ Docker image built successfully"
        '''
      }
    }

    stage('Stop Running Containers') {
      when {
        expression { 
          return params.DEPLOYMENT_ACTION in ['deploy', 'rebuild', 'restart']
        }
      }
      steps {
        echo '⏹️  Stopping running containers...'
        sh '''
          set -e
          
          # Stop containers if they exist
          docker stop "${CONTAINER_NAME}" 2>/dev/null || true
          docker rm "${CONTAINER_NAME}" 2>/dev/null || true
          
          if [ "${DEPLOYMENT_ACTION}" = "rebuild" ]; then
            echo "🔄 Rebuild mode: also stopping database..."
            docker stop "${DB_CONTAINER_NAME}" 2>/dev/null || true
            docker rm "${DB_CONTAINER_NAME}" 2>/dev/null || true
          fi
          
          echo "✅ Containers stopped"
        '''
      }
    }

    stage('Create .env File') {
      when {
        expression { 
          return params.DEPLOYMENT_ACTION in ['deploy', 'rebuild']
        }
      }
      steps {
        echo '⚙️  Creating environment configuration...'
        sh '''
          set -eux
          
          ENV_FILE="${DEPLOY_ROOT}/.env"
          
          cat > "${ENV_FILE}" <<EOF
# Backend Configuration
BACKEND_IMAGE=${IMAGE_REF}
BACKEND_PORT=${BACKEND_PORT}
BACKEND_ENVIRONMENT=local

# Database Configuration
DB_CONTAINER_NAME=${DB_CONTAINER_NAME}
MYSQL_ROOT_PASSWORD=root_password_local
MYSQL_DATABASE=${MYSQL_DATABASE}
MYSQL_USER=alld_user
MYSQL_PASSWORD=alld_password_local
DB_PORT=${DB_PORT}

# Application Configuration
JAVA_OPTS=-Xmx1024m -Xms512m
TZ=Asia/Kolkata

# JWT & Security
JWT_SECRET=local_jwt_secret_key_$(date +%s)

# AWS Configuration (Optional - for S3 file storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET=dba-alld-local

# Logging
LOG_LEVEL=INFO
APP_LOG_DIR=/var/log/alld-backend

# Docker
DOCKER_NETWORK=${DOCKER_NETWORK}
EOF
          
          chmod 600 "${ENV_FILE}"
          echo "✅ Environment file created: ${ENV_FILE}"
        '''
      }
    }

    stage('Deploy Services') {
      when {
        expression { 
          return params.DEPLOYMENT_ACTION in ['deploy', 'rebuild']
        }
      }
      steps {
        echo '🚀 Deploying services with Docker Compose...'
        sh '''
          set -eux
          
          cd "${DEPLOY_ROOT}"
          
          ENV_FILE="${DEPLOY_ROOT}/.env"
          COMPOSE_FILE="${DEPLOY_ROOT}/docker-compose.backend.dev.yml"
          
          if [ ! -f "${ENV_FILE}" ]; then
            echo "❌ Environment file not found: ${ENV_FILE}"
            exit 1
          fi
          
          if [ ! -f "${COMPOSE_FILE}" ]; then
            echo "❌ Docker Compose file not found: ${COMPOSE_FILE}"
            exit 1
          fi
          
          # Start services
          if [ "${DEPLOYMENT_ACTION}" = "rebuild" ]; then
            echo "🔄 Rebuild mode: recreating all services..."
            docker compose \
              --env-file "${ENV_FILE}" \
              -f "${COMPOSE_FILE}" \
              up -d --force-recreate --remove-orphans
          else
            echo "📦 Deploy mode: updating backend service..."
            docker compose \
              --env-file "${ENV_FILE}" \
              -f "${COMPOSE_FILE}" \
              up -d --force-recreate backend
          fi
          
          # Show status
          echo ""
          echo "📊 Service Status:"
          docker compose \
            --env-file "${ENV_FILE}" \
            -f "${COMPOSE_FILE}" \
            ps
          
          echo ""
          echo "✅ Services deployed successfully"
        '''
      }
    }

    stage('Verify Deployment') {
      when {
        expression { 
          return params.DEPLOYMENT_ACTION in ['deploy', 'rebuild']
        }
      }
      steps {
        echo '✅ Verifying deployment...'
        script {
          sleep(5) // Wait for container to start
          
          sh '''
            set -e
            
            echo "🔍 Checking container health..."
            
            # Check if container is running
            if ! docker ps | grep -q "${CONTAINER_NAME}"; then
              echo "❌ Backend container is not running!"
              docker logs "${CONTAINER_NAME}" 2>/dev/null || true
              exit 1
            fi
            
            echo "✅ Backend container is running"
            
            # Wait for health check (max 60 seconds)
            MAX_ATTEMPTS=12
            ATTEMPT=0
            while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
              HEALTH_STATUS=$(docker inspect --format='{{.State.Health.Status}}' "${CONTAINER_NAME}" 2>/dev/null || echo "none")
              
              if [ "$HEALTH_STATUS" = "healthy" ]; then
                echo "✅ Backend is healthy"
                break
              elif [ "$HEALTH_STATUS" = "unhealthy" ]; then
                echo "❌ Backend health check failed"
                docker logs --tail 30 "${CONTAINER_NAME}"
                exit 1
              fi
              
              ATTEMPT=$((ATTEMPT + 1))
              if [ $ATTEMPT -lt $MAX_ATTEMPTS ]; then
                echo "⏳ Health check in progress... ($ATTEMPT/$MAX_ATTEMPTS)"
                sleep 5
              fi
            done
            
            if [ $ATTEMPT -ge $MAX_ATTEMPTS ]; then
              echo "⚠️  Health check timeout, but continuing..."
            fi
          '''
        }
      }
    }

    stage('Show Logs') {
      when {
        expression { params.DEPLOYMENT_ACTION == 'logs' }
      }
      steps {
        echo '📋 Showing backend logs...'
        sh '''
          set -e
          
          if docker ps | grep -q "${CONTAINER_NAME}"; then
            echo "📋 Last 50 lines of backend logs:"
            echo "════════════════════════════════════════════════════════"
            docker logs --tail 50 "${CONTAINER_NAME}"
            echo "════════════════════════════════════════════════════════"
          else
            echo "❌ Backend container is not running"
          fi
        '''
      }
    }

    stage('Restart Services') {
      when {
        expression { params.DEPLOYMENT_ACTION == 'restart' }
      }
      steps {
        echo '🔄 Restarting services...'
        sh '''
          set -eux
          
          echo "Restarting ${CONTAINER_NAME}..."
          docker restart "${CONTAINER_NAME}"
          
          echo "⏳ Waiting for backend to become healthy..."
          sleep 3
          
          # Show status
          docker ps --format "table {{.Names}}\t{{.Status}}"
          
          echo "✅ Services restarted"
        '''
      }
    }

    stage('Rollback') {
      when {
        expression { params.DEPLOYMENT_ACTION == 'rollback' }
      }
      steps {
        echo '⏮️  Rolling back to previous version...'
        script {
          sh '''
            set -eux
            
            cd "${DEPLOY_ROOT}"
            ENV_FILE="${DEPLOY_ROOT}/.env"
            COMPOSE_FILE="${DEPLOY_ROOT}/docker-compose.backend.dev.yml"
            
            echo "Getting previous image tag from Docker..."
            
            # Get second-to-last image
            PREVIOUS_TAG=$(docker images --format "table {{.Repository}}:{{.Tag}}" | \
              grep "${IMAGE_NAME}" | head -2 | tail -1 | cut -d: -f2)
            
            if [ -z "$PREVIOUS_TAG" ]; then
              echo "❌ No previous image found for rollback"
              exit 1
            fi
            
            echo "Rolling back to: ${IMAGE_NAME}:${PREVIOUS_TAG}"
            
            # Update .env file
            sed -i.bak "s|BACKEND_IMAGE=.*|BACKEND_IMAGE=${REGISTRY}/${IMAGE_NAME}:${PREVIOUS_TAG}|" "${ENV_FILE}"
            rm -f "${ENV_FILE}.bak"
            
            # Restart with previous image
            docker compose \
              --env-file "${ENV_FILE}" \
              -f "${COMPOSE_FILE}" \
              up -d --force-recreate backend
            
            echo "✅ Rollback completed"
          '''
        }
      }
    }
  }

  post {
    success {
      script {
        if (params.DEPLOYMENT_ACTION in ['deploy', 'rebuild']) {
          echo "╔════════════════════════════════════════════════════════════╗"
          echo "║           ✅ BUILD & DEPLOYMENT SUCCESSFUL ✅              ║"
          echo "╚════════════════════════════════════════════════════════════╝"
          echo ""
          sh '''
            echo "📊 Deployment Summary:"
            echo "  Backend URL: http://localhost:${BACKEND_PORT}"
            echo "  Image: ${IMAGE_REF}"
            echo "  Deployment Root: ${DEPLOY_ROOT}"
            echo ""
            echo "🔍 Check Logs:"
            echo "  docker logs ${CONTAINER_NAME}"
            echo ""
            echo "🛑 To Stop:"
            echo "  docker compose -f ${DEPLOY_ROOT}/docker-compose.backend.dev.yml down"
            echo ""
          '''
        }
      }
    }
    failure {
      echo "╔════════════════════════════════════════════════════════════╗"
      echo "║           ❌ BUILD & DEPLOYMENT FAILED                    ║"
      echo "╚════════════════════════════════════════════════════════════╝"
      echo ""
      sh '''
        echo "Troubleshooting Steps:"
        echo "1. Check local code exists: ls -la ${CODE_ROOT}"
        echo "2. View error logs: docker logs ${CONTAINER_NAME}"
        echo "3. Check Maven build: cd ${CODE_ROOT} && ./mvnw clean compile"
        echo "4. Verify Docker: docker ps, docker images"
        echo ""
        echo "Getting last 30 lines of backend logs:"
        docker logs --tail 30 "${CONTAINER_NAME}" 2>/dev/null || echo "Container not available for logging"
      '''
    }
    always {
      script {
        echo ""
        echo "📋 Build Report:"
        echo "  Build Number: ${BUILD_NUMBER}"
        echo "  Build Status: ${currentBuild.result}"
        echo "  Build URL: ${BUILD_URL}"
        echo ""
        
        // Archive logs if containers exist
        sh '''
          if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
            mkdir -p "${DEPLOY_ROOT}/logs"
            docker logs "${CONTAINER_NAME}" > "${DEPLOY_ROOT}/logs/backend_${BUILD_NUMBER}.log" 2>&1 || true
            
            echo "✅ Build log saved: ${DEPLOY_ROOT}/logs/backend_${BUILD_NUMBER}.log"
          fi
        '''
      }
    }
  }
}
