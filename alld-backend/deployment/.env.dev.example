# ---------- Port Configuration ----------
# Backend API port (maps container 8081 to host 5081)
BACKEND_PORT=5081
# Management port is internal (8090), not exposed to host

# ---------- Backend routing ----------
BACKEND_HOST=dev-api-alld.example.com
TRAEFIK_ENTRYPOINT=web
TRAEFIK_TLS=false

# ---------- Timezone ----------
TZ=Asia/Kolkata

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root-pass
MYSQL_DATABASE=dba
MYSQL_USER=rwroot
MYSQL_PASSWORD=change-me-app-pass

# ---------- Spring app secrets ----------
JWT_SECRET=replace-with-at-least-32-characters
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
APP_LOG_DIR=/app/logs

# Optional app config overrides
# MEDIA_BASE_URL=http://dev-api-alld.example.com:5081
# APP_CORS_ALLOWED_ORIGINS=http://dev-frontend-alld.example.com:5080
